# Ollama 模型服务地址和模型名称。
OLLAMA_URL=http://localhost:11434/api/chat
MODEL=qwen3:8b

# 主 Agent 调用审核 Agent 的内部地址，以及审核服务监听端口。
A2A_AUDIT_URL=http://127.0.0.1:8090/a2a/task
A2A_PORT=8090

# 对业务方暴露的 Agent HTTP API；生产环境必须设置高强度 API Key。
AGENT_API_PORT=8080
AGENT_API_KEY=

# MySQL 连接参数。真实密码只写入被 Git 忽略的 .env。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=agent_business_demo
DB_USER=root
DB_PASSWORD=请填写本地MySQL密码
